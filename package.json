{
  "name": "adota-pet",
  "version": "1.0.0",
  "description": "Plataforma de adoção de animais — ONG Love Patinhas",
  "main": "src/backend/server.js",
  "scripts": {
    "start": "node src/backend/server.js",
    "dev": "nodemon src/backend/server.js",
    "test": "node --test \"test/unit/*.test.js\" \"test/integration/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:watch": "node --test --watch \"test/unit/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/unit/*.test.js\" \"test/integration/*.test.js\"",
    "test:integration": "node --env-file=.env.test --test \"test/integration/*.test.js\"",
    "db:migrate": "node scripts/migrate-db.js",
    "db:test:up": "docker compose --profile test up -d --wait db-test",
    "db:test:down": "docker compose --profile test rm -sf db-test"
  },
  "keywords": [
    "adoção",
    "pets",
    "ong"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}

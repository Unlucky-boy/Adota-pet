<%- include('../layout-header') %>

<section class="donation-section">
  <div class="container">
    <div class="donation-card">
      <div class="donation-card__header">
        <span class="donation-card__icon">💛</span>
        <h1>Faça uma Doação</h1>
        <p>Sua contribuição ajuda a manter os cuidados com os animais da ONG Love Patinhas</p>
      </div>
      <form class="form" method="POST" action="/donate" id="donateForm" enctype="multipart/form-data">
        <input type="hidden" name="payment_method" value="pix">
        
        <!-- Valor -->
        <div class="form__group">
          <label for="donate-amount">Valor da doação (R$) *</label>
          <div class="amount-input-wrapper">
            <span class="amount-input-prefix">R$</span>
            <input
              type="number"
              id="donate-amount"
              name="amount"
              required
              min="1"
              max="100000"
              step="0.01"
              placeholder="50.00"
              value="<%= (formData && formData.amount) ? formData.amount : '' %>"
              <%= !pixKey ? 'disabled' : '' %>
            >
          </div>
        </div>

        <!-- Valores sugeridos -->
        <div class="suggested-amounts">
          <button type="button" class="suggested-amounts__btn" data-value="10" <%= !pixKey ? 'disabled' : '' %>>R$ 10</button>
          <button type="button" class="suggested-amounts__btn" data-value="25" <%= !pixKey ? 'disabled' : '' %>>R$ 25</button>
          <button type="button" class="suggested-amounts__btn" data-value="50" <%= !pixKey ? 'disabled' : '' %>>R$ 50</button>
          <button type="button" class="suggested-amounts__btn" data-value="100" <%= !pixKey ? 'disabled' : '' %>>R$ 100</button>
          <button type="button" class="suggested-amounts__btn" data-value="200" <%= !pixKey ? 'disabled' : '' %>>R$ 200</button>
        </div>

        <!-- Bloco PIX -->
        <div id="pixSection" class="pix-section">
          <% if (pixKey) { %>
            <div class="pix-info-box">
              <div class="pix-info-box__header">
                <span>📱</span>
                <strong>Chave PIX da ONG</strong>
              </div>
              <div class="pix-info-box__key">
                <code id="pixKeyValue"><%= pixKey %></code>
                <button type="button" class="btn btn--outline btn--sm" onclick="copyPix()">📋 Copiar</button>
              </div>
              <div style="text-align: center; margin-top: 1.5rem;">
                <button type="button" class="btn btn--outline" id="generate-qr-btn">🔄 Gerar QR Code de Pagamento</button>
              </div>

              <div id="pix-qr-container" style="display: none; text-align: center; margin-top: 1rem; padding: 1rem; background: #fafafa; border-radius: 8px; border: 1px dashed #ccc;">
                <p style="font-size: 0.9rem; color: #333; margin-bottom: 0.5rem; font-weight: bold;">Escaneie o QR Code ou use o Copia e Cola:</p>
                <img id="pix-qr-img" src="" alt="QR Code PIX" style="max-width: 200px; height: auto; margin: 0.5rem auto;">
                <div style="margin-top: 1rem;">
                  <code id="pixPayloadValue" style="display:block; word-break: break-all; font-size: 0.75rem; color: #666; margin-bottom: 0.5rem; background: #fff; padding: 0.5rem; border: 1px solid #eee;"></code>
                  <button type="button" class="btn btn--sm" style="background: #28a745; color: white; border: none; margin-top: 0.5rem;" onclick="copyPixPayload()">📋 Copiar Código PIX</button>
                </div>
              </div>
              <p class="pix-info-box__hint">Faça a transferência e envie o comprovante abaixo</p>
            </div>

            <div class="form__group">
              <label for="receipt-upload">Comprovante do PIX (opcional)</label>
              <input
                type="file"
                id="receipt-upload"
                name="receipt_image"
                accept="image/jpeg,image/png,image/webp,application/pdf"
              >
              <span class="form__hint">Formatos aceitos: JPG, PNG, WebP, PDF (máx. 5MB)</span>
            </div>
            
            <!-- Dados opcionais do doador -->
            <div class="form__divider">
              <span>Dados do doador (opcional)</span>
            </div>
            <div class="form__row">
              <div class="form__group">
                <label for="donate-name">Nome</label>
                <input
                  type="text"
                  id="donate-name"
                  name="donor_name"
                  placeholder="Seu nome"
                  value="<%= (formData && formData.donor_name) ? formData.donor_name : '' %>"
                  autocomplete="name"
                >
              </div>
              <div class="form__group">
                <label for="donate-email">E-mail</label>
                <input
                  type="email"
                  id="donate-email"
                  name="donor_email"
                  placeholder="seu@email.com"
                  value="<%= (formData && formData.donor_email) ? formData.donor_email : '' %>"
                  autocomplete="email"
                >
              </div>
            </div>

            <button type="submit" class="btn btn--primary btn--lg btn--full">💛 Confirmar Doação</button>

          <% } else { %>
            <div class="pix-info-box pix-info-box--warning">
              <p>⚠️ A chave PIX ainda não foi cadastrada pela ONG. As doações estão temporariamente indisponíveis.</p>
            </div>
          <% } %>
        </div>
      </form>
      <div class="donation-card__footer">
        <% if (projectEmail) { %>
          <p>📧 E-mail do projeto: <strong><%= projectEmail %></strong></p>
        <% } %>
        <p>🔒 Pagamento simulado — ambiente de demonstração</p>
        <a href="/">← Voltar para o site</a>
      </div>
    </div>
  </div>
</section>

<script>
  // === Valores sugeridos ===
  document.querySelectorAll('.suggested-amounts__btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (this.hasAttribute('disabled')) return;
      var input = document.getElementById('donate-amount');
      var currentVal = parseFloat(input.value) || 0;
      var addVal = parseFloat(this.dataset.value);
      input.value = (currentVal + addVal).toFixed(2);
      
      // Efeito visual rápido
      var originalTransform = this.style.transform;
      this.style.transform = 'scale(0.95)';
      setTimeout(() => this.style.transform = originalTransform || 'scale(1)', 100);
    });
  });

  // === Gerador de PIX Payload (EMV) ===
  function generatePixPayload(key, amount, merchantName, merchantCity) {
      let payload = "000201";
      let gui = "0014br.gov.bcb.pix";
      let keyStr = "01" + key.length.toString().padStart(2, '0') + key;
      let accInfo = gui + keyStr;
      payload += "26" + accInfo.length.toString().padStart(2, '0') + accInfo;
      payload += "52040000";
      payload += "5303986";
      if (amount && parseFloat(amount) > 0) {
          let amountStr = parseFloat(amount).toFixed(2);
          payload += "54" + amountStr.length.toString().padStart(2, '0') + amountStr;
      }
      payload += "5802BR";
      merchantName = merchantName.substring(0, 25).toUpperCase().padEnd(2, ' ').trim() || "ONG";
      payload += "59" + merchantName.length.toString().padStart(2, '0') + merchantName;
      merchantCity = merchantCity.substring(0, 15).toUpperCase().padEnd(2, ' ').trim() || "CIDADE";
      payload += "60" + merchantCity.length.toString().padStart(2, '0') + merchantCity;
      let txid = "***";
      let addData = "05" + txid.length.toString().padStart(2, '0') + txid;
      payload += "62" + addData.length.toString().padStart(2, '0') + addData;
      payload += "6304";
      let crc = 0xFFFF;
      for (let i = 0; i < payload.length; i++) {
          crc ^= payload.charCodeAt(i) << 8;
          for (let j = 0; j < 8; j++) {
              if ((crc & 0x8000) !== 0) {
                  crc = (crc << 1) ^ 0x1021;
              } else {
                  crc = crc << 1;
              }
          }
      }
      return payload + (crc & 0xFFFF).toString(16).toUpperCase().padStart(4, '0');
  }

  var generateBtn = document.getElementById('generate-qr-btn');
  if (generateBtn) {
    generateBtn.addEventListener('click', function() {
      var amount = document.getElementById('donate-amount').value;
      if (!amount || parseFloat(amount) <= 0) {
        alert('Por favor, informe um valor válido para gerar o QR Code.');
        document.getElementById('donate-amount').focus();
        return;
      }
      var pixKey = document.getElementById('pixKeyValue').textContent.trim();
      var payload = generatePixPayload(pixKey, amount, "ONG Love Patinhas", "SAO PAULO");
      
      document.getElementById('pixPayloadValue').textContent = payload;
      document.getElementById('pix-qr-img').src = "https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=" + encodeURIComponent(payload);
      document.getElementById('pix-qr-container').style.display = 'block';
    });
  }

  function copyPixPayload() {
    var payloadText = document.getElementById('pixPayloadValue').textContent;
    navigator.clipboard.writeText(payloadText).then(function() {
      alert('Código PIX Copia e Cola copiado com sucesso!');
    }).catch(function() {
      var textArea = document.createElement('textarea');
      textArea.value = payloadText;
      document.body.appendChild(textArea);
      textArea.select();
      document.execCommand('copy');
      document.body.removeChild(textArea);
      alert('Código PIX Copia e Cola copiado!');
    });
  }

  // === Copiar chave PIX ===
  function copyPix() {
    var pixKey = document.getElementById('pixKeyValue');
    if (!pixKey) return;
    navigator.clipboard.writeText(pixKey.textContent).then(function() {
      alert('Chave PIX copiada!');
    }).catch(function() {
      var textArea = document.createElement('textarea');
      textArea.value = pixKey.textContent;
      document.body.appendChild(textArea);
      textArea.select();
      document.execCommand('copy');
      document.body.removeChild(textArea);
      alert('Chave PIX copiada!');
    });
  }
</script>

<%- include('../layout-footer') %>

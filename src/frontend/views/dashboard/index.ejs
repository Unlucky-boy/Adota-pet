<%- include('../layout-header') %>

<%
  const formatDate = (value) => {
    if (!value) return '—';
    if (typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value.slice(0, 10))) {
      return value.slice(0, 10).split('-').reverse().join('/');
    }
    return new Intl.DateTimeFormat('pt-BR', { timeZone: 'America/Sao_Paulo' }).format(new Date(value));
  };
  const formatMoney = (value) => Number(value || 0)
    .toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  const adoptionStatuses = {
    pending: 'Pendente', under_review: 'Em análise', interview: 'Entrevista', visit: 'Visita',
    approved: 'Aprovada', rejected: 'Rejeitada', cancelled: 'Cancelada', completed: 'Concluída',
  };
  const visitStatuses = { scheduled: 'Agendada', completed: 'Realizada', cancelled: 'Cancelada' };
  const visitTypes = { home_visit: 'Visita domiciliar', interview: 'Entrevista' };
  const volunteerStatuses = { pending: 'Pendente', approved: 'Aprovada', rejected: 'Rejeitada' };
  const donationStatuses = {
    completed: 'Confirmada', pending_payment: 'Aguardando PIX',
    pending_review: 'Em análise', rejected: 'Rejeitada',
  };
%>

<section class="profile-page">
  <div class="container">
    <header class="profile-hero">
      <div class="profile-hero__avatar" aria-hidden="true"><i data-lucide="user-round"></i></div>
      <div>
        <span class="profile-hero__eyebrow">Área do adotante</span>
        <h1>Olá, <%= adopter.name %>!</h1>
        <p>Acompanhe suas adoções, atividades voluntárias e contribuições em um só lugar.</p>
      </div>
    </header>

    <div class="profile-layout">
      <aside class="profile-sidebar" aria-label="Dados e ações do perfil">
        <section class="profile-card">
          <div class="profile-card__heading">
            <div><span class="profile-card__eyebrow">Seus dados</span><h2>Dados cadastrais</h2></div>
            <i data-lucide="contact" aria-hidden="true"></i>
          </div>
          <dl class="profile-details">
            <div><dt><i data-lucide="user" aria-hidden="true"></i> Nome</dt><dd><%= adopter.name %></dd></div>
            <div><dt><i data-lucide="mail" aria-hidden="true"></i> E-mail</dt><dd><a href="mailto:<%= adopter.email %>"><%= adopter.email %></a></dd></div>
            <div><dt><i data-lucide="phone" aria-hidden="true"></i> Telefone</dt><dd><%= adopter.phone %></dd></div>
            <div><dt><i data-lucide="map-pin" aria-hidden="true"></i> Endereço</dt><dd><%= adopter.address %></dd></div>
          </dl>
        </section>

        <nav class="profile-card profile-actions" aria-label="Ações rápidas">
          <span class="profile-card__eyebrow">Ações rápidas</span>
          <a href="/pets"><i data-lucide="paw-print"></i><span>Encontrar um pet<small>Conheça os animais disponíveis</small></span><i data-lucide="chevron-right"></i></a>
          <a href="/volunteer"><i data-lucide="hand-heart"></i><span>Ser voluntário<small>Ajude na rotina da ONG</small></span><i data-lucide="chevron-right"></i></a>
          <a href="/donate"><i data-lucide="heart"></i><span>Fazer uma doação<small>Apoie os nossos resgates</small></span><i data-lucide="chevron-right"></i></a>
        </nav>
      </aside>

      <div class="profile-content">
        <section class="profile-card" aria-labelledby="adoptions-title">
          <div class="profile-card__heading">
            <div><span class="profile-card__eyebrow">Acompanhamento</span><h2 id="adoptions-title">Solicitações de adoção</h2></div>
            <span class="profile-count"><%= userAdoptions.length %></span>
          </div>

          <% if (userAdoptions.length > 0) { %>
            <div class="profile-list">
              <% userAdoptions.forEach(function(adoption) { %>
                <article class="adoption-item">
                  <img src="<%= adoption.pet_image_url || '/img/pets/default.jpg' %>" alt="Foto de <%= adoption.pet_name %>" onerror="this.src='/img/pets/default.jpg'">
                  <div class="adoption-item__body">
                    <div class="adoption-item__topline">
                      <div><h3><%= adoption.pet_name %></h3><p>Solicitada em <%= formatDate(adoption.created_at) %></p></div>
                      <span class="profile-status profile-status--<%= adoption.status %>"><%= adoptionStatuses[adoption.status] || adoption.status %></span>
                    </div>

                    <% if (adoption.visit_date && adoption.visit_time) { %>
                      <div class="appointment-card">
                        <i data-lucide="calendar-days" aria-hidden="true"></i>
                        <div><strong><%= visitTypes[adoption.visit_type] || 'Visita ou entrevista' %></strong><span><%= formatDate(adoption.visit_date) %>, às <%= String(adoption.visit_time).slice(0, 5) %></span></div>
                        <span class="profile-status profile-status--<%= adoption.visit_status %>"><%= visitStatuses[adoption.visit_status] || adoption.visit_status %></span>
                      </div>
                    <% } else { %>
                      <div class="appointment-card appointment-card--empty"><i data-lucide="calendar-clock" aria-hidden="true"></i><span>Nenhuma visita ou entrevista agendada para esta solicitação.</span></div>
                    <% } %>
                  </div>
                </article>
              <% }); %>
            </div>
          <% } else { %>
            <div class="profile-empty">
              <i data-lucide="paw-print" aria-hidden="true"></i>
              <h3>Nenhuma solicitação de adoção</h3>
              <p>Quando você demonstrar interesse por um pet, poderá acompanhar cada etapa por aqui.</p>
              <a href="/pets" class="btn btn--primary">Conhecer os pets</a>
            </div>
          <% } %>
        </section>

        <section class="profile-card" aria-labelledby="volunteer-title">
          <div class="profile-card__heading">
            <div><span class="profile-card__eyebrow">Participação</span><h2 id="volunteer-title">Voluntariado</h2></div>
            <i data-lucide="hand-heart" aria-hidden="true"></i>
          </div>

          <% if (userVolunteers.length > 0) { %>
            <div class="profile-rows">
              <% userVolunteers.forEach(function(volunteer) { %>
                <article class="profile-row">
                  <div>
                    <strong>Inscrição de <%= formatDate(volunteer.created_at) %></strong>
                    <span><%= volunteer.availability %></span>
                    <% if (volunteer.reviewed_at) { %><small>Atualizada em <%= formatDate(volunteer.reviewed_at) %></small><% } %>
                  </div>
                  <span class="profile-status profile-status--<%= volunteer.status %>"><%= volunteerStatuses[volunteer.status] || volunteer.status %></span>
                </article>
              <% }); %>
            </div>
          <% } else { %>
            <div class="profile-empty profile-empty--compact">
              <i data-lucide="hand-heart" aria-hidden="true"></i>
              <h3>Você ainda não possui inscrição de voluntário</h3>
              <p>Há muitas formas de colocar seu tempo e seus talentos a serviço dos animais.</p>
              <a href="/volunteer" class="btn btn--outline">Quero ser voluntário</a>
            </div>
          <% } %>
        </section>

        <section class="profile-card" aria-labelledby="donations-title">
          <div class="profile-card__heading profile-card__heading--donations">
            <div><span class="profile-card__eyebrow">Contribuições</span><h2 id="donations-title">Histórico de doações</h2></div>
            <div class="profile-total"><span>Total confirmado</span><strong><%= formatMoney(totalDonated) %></strong></div>
          </div>

          <% if (userDonations.length > 0) { %>
            <div class="table-container">
              <table class="table profile-table">
                <thead><tr><th>Data</th><th>Código</th><th>Valor</th><th>Status</th><th><span class="sr-only">Comprovante</span></th></tr></thead>
                <tbody>
                  <% userDonations.forEach(function(donation) { %>
                    <tr>
                      <td><%= formatDate(donation.created_at) %></td>
                      <td><strong><%= donation.receipt_code %></strong></td>
                      <td><strong><%= formatMoney(donation.amount) %></strong></td>
                      <td><span class="profile-status profile-status--<%= donation.status %>"><%= donationStatuses[donation.status] || donation.status %></span></td>
                      <td class="profile-table__action">
                        <% if (donation.has_receipt) { %>
                          <a href="/donations/<%= donation.id %>/receipt-image" target="_blank" rel="noopener" aria-label="Ver comprovante da doação <%= donation.receipt_code %>"><i data-lucide="paperclip"></i> Ver</a>
                        <% } else if (donation.status === 'pending_payment') { %>
                          <a href="/donate/receipt/<%= donation.receipt_code %>">Enviar comprovante</a>
                        <% } else { %><span>—</span><% } %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="profile-empty profile-empty--compact">
              <i data-lucide="heart" aria-hidden="true"></i>
              <h3>Nenhuma doação no histórico</h3>
              <p>Suas futuras contribuições e o andamento da confirmação aparecerão aqui.</p>
              <a href="/donate" class="btn btn--outline">Fazer uma doação</a>
            </div>
          <% } %>
        </section>
      </div>
    </div>

    <div class="profile-logout"><a href="/logout"><i data-lucide="log-out"></i> Sair da conta</a></div>
  </div>
</section>

<%- include('../layout-footer') %>

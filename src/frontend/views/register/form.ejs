<%- include('../layout-header') %>

<section class="register-section">
  <div class="container">
    <div class="register-card">
      <div class="register-card__header">
        <span class="register-card__icon">📋</span>
        <h1>Cadastre-se</h1>
        <p>Crie sua conta para adotar pets, fazer doações e ser voluntário</p>
      </div>
      <form class="form" method="POST" action="/register" id="registerForm">
        <div class="form__group">
          <label for="register-name">Nome completo *</label>
          <input
            type="text"
            id="register-name"
            name="name"
            required
            placeholder="Seu nome completo"
            value="<%= (formData && formData.name) ? formData.name : '' %>"
            autocomplete="name"
          >
        </div>
        <div class="form__row">
          <div class="form__group">
            <label for="register-cpf">CPF *</label>
            <input
              type="text"
              id="register-cpf"
              name="cpf"
              required
              placeholder="000.000.000-00"
              maxlength="14"
              value="<%= (formData && formData.cpf) ? formData.cpf : '' %>"
              autocomplete="off"
            >
            <small id="cpf-error" style="color: red; display: none; margin-top: 5px;">Digite um CPF válido.</small>
          </div>
          <div class="form__group">
            <label for="register-phone">Telefone *</label>
            <input
              type="tel"
              id="register-phone"
              name="phone"
              required
              placeholder="(00) 00000-0000"
              maxlength="15"
              value="<%= (formData && formData.phone) ? formData.phone : '' %>"
              autocomplete="tel"
            >
          </div>
        </div>
        <div class="form__group">
          <label for="register-email">E-mail *</label>
          <input
            type="email"
            id="register-email"
            name="email"
            required
            placeholder="seu@email.com"
            value="<%= (formData && formData.email) ? formData.email : '' %>"
            autocomplete="email"
          >
        </div>
        <div class="form__row">
          <div class="form__group">
            <label for="register-password">Senha *</label>
            <input
              type="password"
              id="register-password"
              name="password"
              required
              placeholder="Sua senha"
              minlength="6"
            >
          </div>
          <div class="form__group">
            <label for="register-password-confirm">Confirmar Senha *</label>
            <input
              type="password"
              id="register-password-confirm"
              name="password_confirm"
              required
              placeholder="Confirme a senha"
              minlength="6"
            >
            <small id="password-error" style="color: red; display: none; margin-top: 5px;">As senhas não coincidem.</small>
          </div>
        </div>
        <div class="form__group">
          <label for="register-address">Endereço completo *</label>
          <textarea
            id="register-address"
            name="address"
            required
            rows="3"
            placeholder="Rua, número, bairro, cidade — UF"
            autocomplete="street-address"
          ><%= (formData && formData.address) ? formData.address : '' %></textarea>
        </div>
        <button type="submit" class="btn btn--primary btn--lg btn--full">📋 Finalizar Cadastro</button>
      </form>
      <div class="register-card__footer">
        <a href="/">← Voltar para o site</a>
      </div>
    </div>
  </div>
</section>

<script>
  // === Validação de CPF ===
  function validarCPF(cpf) {
    cpf = cpf.replace(/[^\d]+/g, '');
    if (cpf == '') return false;
    if (cpf.length != 11 || /^(\d)\1{10}$/.test(cpf)) return false;
    var add = 0;
    for (var i = 0; i < 9; i++) add += parseInt(cpf.charAt(i)) * (10 - i);
    var rev = 11 - (add % 11);
    if (rev == 10 || rev == 11) rev = 0;
    if (rev != parseInt(cpf.charAt(9))) return false;
    add = 0;
    for (var i = 0; i < 10; i++) add += parseInt(cpf.charAt(i)) * (11 - i);
    rev = 11 - (add % 11);
    if (rev == 10 || rev == 11) rev = 0;
    if (rev != parseInt(cpf.charAt(10))) return false;
    return true;
  }

  var cpfInput = document.getElementById('register-cpf');
  var cpfError = document.getElementById('cpf-error');
  var passwordInput = document.getElementById('register-password');
  var passwordConfirmInput = document.getElementById('register-password-confirm');
  var passwordError = document.getElementById('password-error');
  var registerForm = document.getElementById('registerForm');

  cpfInput.addEventListener('blur', function() {
    if (this.value && !validarCPF(this.value)) {
      cpfError.style.display = 'block';
    } else {
      cpfError.style.display = 'none';
    }
  });

  function checkPasswords() {
    if (passwordConfirmInput.value && passwordInput.value !== passwordConfirmInput.value) {
      passwordError.style.display = 'block';
      return false;
    } else {
      passwordError.style.display = 'none';
      return true;
    }
  }

  passwordInput.addEventListener('input', checkPasswords);
  passwordConfirmInput.addEventListener('input', checkPasswords);

  registerForm.addEventListener('submit', function(e) {
    var hasError = false;

    if (!validarCPF(cpfInput.value)) {
      cpfError.style.display = 'block';
      cpfInput.focus();
      hasError = true;
    }

    if (!checkPasswords()) {
      hasError = true;
      if (validarCPF(cpfInput.value)) {
        passwordConfirmInput.focus();
      }
    }

    if (hasError) {
      e.preventDefault();
    }
  });

  // === Máscara de CPF ===
  cpfInput.addEventListener('input', function(e) {
    var v = e.target.value.replace(/\D/g, '');
    if (v.length > 11) v = v.slice(0, 11);
    if (v.length > 9) {
      v = v.replace(/(\d{3})(\d{3})(\d{3})(\d{1,2})/, '$1.$2.$3-$4');
    } else if (v.length > 6) {
      v = v.replace(/(\d{3})(\d{3})(\d{1,3})/, '$1.$2.$3');
    } else if (v.length > 3) {
      v = v.replace(/(\d{3})(\d{1,3})/, '$1.$2');
    }
    e.target.value = v;
    if (cpfError.style.display === 'block') {
      cpfError.style.display = 'none';
    }
  });

  // === Máscara de Telefone ===
  document.getElementById('register-phone').addEventListener('input', function(e) {
    var v = e.target.value.replace(/\D/g, '');
    if (v.length > 11) v = v.slice(0, 11);
    if (v.length > 10) {
      v = v.replace(/(\d{2})(\d{5})(\d{4})/, '($1) $2-$3');
    } else if (v.length > 6) {
      v = v.replace(/(\d{2})(\d{4,5})(\d{0,4})/, '($1) $2-$3');
    } else if (v.length > 2) {
      v = v.replace(/(\d{2})(\d{0,5})/, '($1) $2');
    }
    e.target.value = v;
  });
</script>

<%- include('../layout-footer') %>
